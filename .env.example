# Local LLM (Ollama) settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Set to true to force offline deterministic mode (useful when Ollama is not running)
USE_FALLBACK_LLM=false

# Guardrails & Risk Thresholds
CONFIDENCE_THRESHOLD=0.65
MAX_DTI_RATIO=0.50
MAX_RESUBMIT_ATTEMPTS=3

# Persistence
DATABASE_PATH=data/loan_reviews.db
CHECKPOINT_DB_PATH=data/langgraph_checkpoints.db
